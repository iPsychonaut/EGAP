// Defaults for draft_assembly.nf. Override any of them on the command line,
// e.g. `nextflow run draft_assembly.nf --input_tsv samples.tsv --no_flye`.
params {
    input_tsv = "/mnt/d/TESTING_SPACE/EGAP_test.tsv"
    output_dir = "/mnt/d/TESTING_SPACE/nextflow_test/"
    cpu_threads = 12
    ram_gb = 40

    // Same meaning as the EGAP.py flags of the same name.
    dry_run = false
    intermediate_format = 'pigz'   // pigz | fastb
    busco_only = false
    no_masurca = false
    no_flye = false
    no_spades = false
    no_hifiasm = false
}

process {
    cpus = params.cpu_threads
    memory = "${params.ram_gb} GB"
    maxForks = 1   // every stage is handed the whole CPU/RAM budget
    executor = 'local'
    container = "${projectDir}/entheome.sif"
}

singularity {
    enabled = true
    autoMounts = true
    // The input table's folder, the output folder and the drive holding the
    // reads must be visible inside the image.
    runOptions = '--bind /mnt/d:/mnt/d'  // CHANGE THIS IF YOU HAVE DIFFERENT DRIVE NAME CONTAINING DATA
}

profiles {
    local {
        process.executor = 'local'
    }
    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
    }
    singularity {
        process.executor = 'local'
    }
}
