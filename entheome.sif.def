# Entheome ecosystem Singularity/Apptainer image, built from the Docker image.
#
# The Dockerfile is the single place where the three conda environments
# (EGAP_env, EGEP_env, funannotate_env), their pins and the EGAP scripts are
# defined. This file only wraps that image, so the two cannot drift apart.
#
# TO BUILD (on a machine with Docker and Singularity/Apptainer >= 3.8):
#   docker build -t entheome_ecosystem:3.4.2 .
#   sudo singularity build entheome.sif entheome.sif.def
#
# No Docker daemon on the Singularity build machine? Save the image where
# Docker runs, copy the tar across, and swap the two header lines below:
#   docker save entheome_ecosystem:3.4.2 -o entheome_ecosystem_3.4.2.tar
#     Bootstrap: docker-archive
#     From: entheome_ecosystem_3.4.2.tar
# Or, once the image is pushed to a registry:
#     Bootstrap: docker
#     From: <registry user>/entheome_ecosystem:3.4.2

Bootstrap: docker-daemon
From: entheome_ecosystem:3.4.2

%labels
    Author       Ian Bollinger <ian.bollinger@entheome.org>
    Maintainer   Ian M Bollinger <ian.bollinger@entheome.org>
    Version      3.4.2
    Description  Entheome ecosystem (EGAP v3.4.2 + EGEP + Funannotate) Singularity image

%environment
    # PATH (EGEP_env, EGAP_env, funannotate_env), AUGUSTUS_CONFIG_PATH, EVM_HOME,
    # PASAHOME, TRINITYHOME, QUARRY_PATH, ZOE, FUNANNOTATE_DB and PYTHONUNBUFFERED
    # come from the Docker image's ENV lines. Only the values a user sets at run
    # time are restated here, so a value from the host or --env wins.
    # e.g.: singularity run --env KRAKEN2_DB=/kraken2_db -B /host/db:/kraken2_db entheome.sif ...
    export KRAKEN2_DB="${KRAKEN2_DB:-}"
    export EGAP_DRY_RUN="${EGAP_DRY_RUN:-0}"

%runscript
    if [ -z "$FUNANNOTATE_DB" ]; then
        echo 'WARNING: FUNANNOTATE_DB is not set. Please set it to your database directory (e.g., export FUNANNOTATE_DB=/path/to/databases) and run "funannotate setup" manually if needed.'
    elif [ ! -d "$FUNANNOTATE_DB" ]; then
        echo 'WARNING: FUNANNOTATE_DB directory ($FUNANNOTATE_DB) does not exist. Please run "funannotate setup -i all -d $FUNANNOTATE_DB" to initialize it.'
    fi

    if [ -z "$KRAKEN2_DB" ]; then
        echo 'WARNING: KRAKEN2_DB is not set. Read decontamination will be skipped.'
        echo '         Mount the database and set the variable at runtime:'
        echo '         singularity run --env KRAKEN2_DB=/kraken2_db -B /host/db:/kraken2_db entheome.sif ...'
    elif [ ! -d "$KRAKEN2_DB" ]; then
        echo "WARNING: KRAKEN2_DB directory ($KRAKEN2_DB) does not exist. Read decontamination will be skipped."
    fi

    exec "$@"

%help
    Entheome ecosystem Singularity image (EGAP v3.4.2 + EGEP + Funannotate),
    built from the entheome_ecosystem Docker image.

    Three conda environments are baked in, unpacked at the image root (there
    is no conda executable in the image, so nothing needs activating):
      /EGAP_env         genome assembly pipeline (primary)
      /EGEP_env         auxiliary annotation tools
      /funannotate_env  Funannotate for eukaryotic genome annotation
    All three bin/ folders are on PATH, EGEP_env first.

    ---------------------------------------------------------------------------
    Running EGAP
    ---------------------------------------------------------------------------
    The Kraken2 database is intentionally NOT baked in (16 GB archive). Mount
    it from the host and point KRAKEN2_DB at the mount:

      singularity run \
          --env KRAKEN2_DB=/kraken2_db \
          -B /host/kraken2_db:/kraken2_db \
          -B /host/data:/data \
          entheome.sif \
          EGAP --input_tsv /data/samples.tsv \
               --output_dir /data/output \
               --cpu_threads 16 --ram_gb 64

    Without Kraken2 (read decontamination skipped):

      singularity run -B /host/data:/data entheome.sif \
          EGAP --input_tsv /data/samples.tsv --output_dir /data/output

    Always start EGAP through the EGAP launcher (/EGAP_env/bin/EGAP). It puts
    EGAP_env first on PATH (EGEP_env also ships trimmomatic and its own python)
    and sets CONDA_PREFIX, which is how EGAP finds Trimmomatic's TruSeq3-PE.fa
    adapters. The Nextflow runner (draft_assembly.nf) does the same for each
    stage.

    ---------------------------------------------------------------------------
    Environment variables
    ---------------------------------------------------------------------------
    FUNANNOTATE_DB    Path to funannotate databases (default: /opt/databases,
                      set up when the Docker image was built)
    KRAKEN2_DB        Path to Kraken2 database directory (required for read
                      decontamination; unset = skip with warning)
    EGAP_DRY_RUN      Set to 1 to log file-management actions without
                      executing them (default: 0)
    PYTHONUNBUFFERED  Set to 1 for real-time log output (default: 1)

    ---------------------------------------------------------------------------
    Provisioning a Kraken2 database on the host
    ---------------------------------------------------------------------------
    Build from source (authoritative, ~6-12 hrs):
      kraken2-build --standard --db /host/kraken2_db --threads 16 --use-ftp

    Download pre-built 16 GB standard index (faster; verify filename at
    https://benlangmead.github.io/aws-indexes/k2):
      wget -c https://genome-idx.s3.amazonaws.com/kraken/k2_standard_16gb_20240904.tar.gz \
           -O /host/kraken2_db/k2_standard_16gb.tar.gz
      tar -xzf /host/kraken2_db/k2_standard_16gb.tar.gz -C /host/kraken2_db/

    ---------------------------------------------------------------------------
    Other workflows
    ---------------------------------------------------------------------------
    Interactive shell with every env on PATH:
      singularity shell entheome.sif

    Use one environment's tools ahead of the others:
      export PATH=/EGAP_env/bin:$PATH         # EGAP v3.4.2 assembly pipeline
      export PATH=/EGEP_env/bin:$PATH         # annotation helpers
      export PATH=/funannotate_env/bin:$PATH  # Funannotate

    Initialise funannotate databases somewhere else (the image already holds
    a set in /opt/databases):
      singularity run entheome.sif funannotate setup -i all -d $FUNANNOTATE_DB

    With GeneMark bind-mounted:
      singularity shell entheome.sif -B /host/genemark:/opt/genemark

    ---------------------------------------------------------------------------
    Validation:
      singularity --version    # requires Apptainer/Singularity >= 3.8
